# Copy to .env and adjust as needed (SPEC §12). Compose already wires the
# api->db connection; these mostly matter for running the api outside Docker.

# DATABASE_URL=postgresql://dooh:dooh@localhost:5432/dooh

# Radius model (metres)
# RADIUS_DEFAULT=500
# RADIUS_MIN=50
# RADIUS_MAX=5000

# Query caps
# POI_SEARCH_LIMIT=2000
# POI_SEARCH_MAX=20000
# MATCH_ANCHOR_MAX=20000

# Apply db/schema.sql automatically on api startup
# AUTO_MIGRATE=1

# OSM node-location index for the ETL (flex_mem = RAM; use
# 'sparse_file_array,/data/osm.idx' for very large extracts on low-RAM hosts)
# OSMIUM_INDEX=flex_mem

# Dev only: vite origin allowed by CORS when running api standalone
# CORS_ORIGINS=http://localhost:5173
